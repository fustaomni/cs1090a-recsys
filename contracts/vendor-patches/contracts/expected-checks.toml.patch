 # blocks a merge forever, with nothing to re-run. The rest are expected HERE, where a missing
 # one makes merge.readiness wait, and a wait that outlasts the deadline halts with its name.
-checks = ["quality gate", "GitGuardian Security Checks"]
+#
+# recsys: only the check this repository's own CI runs. Another app's check is added here once
+# pr has seen it register on this repository, never because cscie103 had it.
+checks = ["quality gate"]
 
 # EACH CHECK'S GITHUB APP, BY SLUG (D.218): pr:checks re-requests only the suite of the app that

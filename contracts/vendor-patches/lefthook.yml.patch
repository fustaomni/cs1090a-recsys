+  # Not parallel: the formatter rewrites files, so it finishes before any check reads them.
   parallel: false
   jobs:
-    # BRANCH GUARD FIRST, BEFORE ANY WORK. The server ruleset already rejects a
-    # PUSH to develop or main, but by then the commit exists and has to be
-    # unwound. Catching it here keeps recovery to a single `git switch -c`.
-    #
-    # Fails closed, which is what an unattended run needs: it will not notice a

+def test_an_unobserved_inventory_is_refused_by_the_policy() -> None:
+    """recsys: evidence under another subject leaves the policy nothing to judge."""
+    found = spine.evaluate(_inventory(), "not_problems", POLICY, ENTRYPOINT)
+    failing = {rule.code for rule in found.rules if rule.outcome == "fail"}
+    assert "ERR_PROBLEMS_INPUT_MISSING" in failing, found
+
+
+def test_no_declared_code_read_is_refused() -> None:
+    """recsys: no rules read is not every rule registered."""
+    assert "ERR_PROBLEMS_DECLARATIONS_UNREAD" in _failing(_inventory(declared=()))
+    assert "ERR_PROBLEMS_DECLARATIONS_UNREAD" not in _failing(_inventory(registry=(_problem(),)))
+
+
+def test_a_code_registered_twice_is_refused() -> None:
+    """recsys: each code is registered once."""
+    twice = _inventory(registry=(_problem(), _problem()))
+    assert "ERR_PROBLEMS_DUPLICATE" in _failing(twice)
+
+
+def test_an_unread_base_is_refused() -> None:
+    """recsys: an unread origin/develop would let a repurposed code pass unseen."""
+    assert "ERR_PROBLEMS_BASE_UNREAD" in _failing(_inventory(base=None))
+
+
+def test_a_registered_code_no_rule_declares_is_refused() -> None:
+    """recsys: a live entry no rule declares is refused and a retired one stands, judged alone."""
+    stale = _inventory(registry=(_problem(), _problem("ERR_GONE")))
+    assert "ERR_PROBLEMS_UNDECLARED" in _failing(stale)
+    retired = Problem(code="ERR_GONE", title="gone", severity="error", retired=True)
+    assert "ERR_PROBLEMS_UNDECLARED" not in _failing(_inventory(registry=(_problem(), retired)))

+def test_provisioning_makes_the_key_directory_owner_only(tmp_path: Path) -> None:
+    """Write access to a directory governs replacing its files: provisioning tightens it."""
+    root, home = _dirs(tmp_path)
+    directory = private_key_path(home).parent
+    directory.mkdir(parents=True)
+    directory.chmod(0o775)
+    assert main([], root=root, home=home) == 0
+    assert (directory.stat().st_mode & 0o777) == 0o700, oct(directory.stat().st_mode)
+
+
+def test_a_key_whose_directory_others_can_write_never_signs(tmp_path: Path) -> None:
+    """A key whose directory was loosened after provisioning signs nothing.
+
+    Checked at use, not only at provisioning (D.161).
+    """
+    root, home = _dirs(tmp_path)
+    assert main([], root=root, home=home) == 0
+    private_key_path(home).parent.chmod(0o775)
+    assert load_signer(root, home) is None
+
+

+
+def test_a_failed_gate_is_refused_by_its_own_rule() -> None:
+    """recsys: a failed gate is refused by name, not only because the passed set falls short."""
+    verdict, _ = judge(evidence("c", "t", _ran("lint"), expected()))
+    assert "ERR_PUBLICATION_GATE_FAILED" in _failing(verdict), verdict
+
+
+def test_nothing_declared_is_refused() -> None:
+    """recsys: an empty declaration is not every gate passing."""
+    verdict, _ = judge(evidence("c", "t", _ran(), ()))
+    assert "ERR_PUBLICATION_NOTHING_EXPECTED" in _failing(verdict), verdict
+
+
+def test_an_absent_publication_record_is_refused_by_the_policy() -> None:
+    """recsys: the evidence under another subject leaves the policy nothing to read."""
+    found = evidence("c", "t", _ran(), expected())
+    verdict = spine.evaluate(found, "not_publish", POLICY, ENTRYPOINT)
+    assert "ERR_PUBLICATION_INPUT_MISSING" in _failing(verdict), verdict

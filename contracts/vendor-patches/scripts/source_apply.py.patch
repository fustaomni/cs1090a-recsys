+def _github_url(remote: str) -> str:
+    """The repository's https URL, parsed from an origin URL in any GitHub form (A.13).
+
+    recsys declares no project identity: git's origin already names the repository, so it is
+    parsed and rebuilt here in the one form a claim records, whatever transport is configured.
+    """
+    url = remote.strip().removesuffix(".git")
+    for prefix in ("git@github.com:", "ssh://git@github.com/", "https://github.com/"):
+        if url.startswith(prefix):
+            parts = url[len(prefix) :].split("/")
+            if len(parts) == 2 and all(parts):
+                return "https://github.com/" + "/".join(parts)
+    raise ValueError(f"origin is not a GitHub repository: {remote.strip()!r}")
+
+
+def _origin_repository(root: Path) -> str:
+    """The repository this checkout's origin names, read once at the boundary."""
+    done = _git("remote", "get-url", "origin", cwd=root)
+    if done.returncode != 0:
+        raise ValueError("no origin remote: " + done.stderr.strip())
+    return _github_url(done.stdout)
 
 

+    @model_validator(mode="after")
+    def _names_what_it_judged(self) -> Verdict:
+        """Its policy by content digest, and its evidence by digest whenever it judged some.
+
+        An unknown verdict judged nothing, and a schema verdict judged a request it is not yet
+        given, so only those two may name no evidence; inventing a digest would be false (A.241).
+        """
+        if not SHA256.fullmatch(self.policy_revision):
+            raise ValueError("a verdict names its policy by its content's SHA-256")
+        judged = self.outcome != "unknown" and not self.entrypoint.startswith("schema:")
+        named = SHA256.fullmatch(self.evidence_digest) is not None
+        if (judged and not named) or (self.evidence_digest and not named):
+            raise ValueError("a verdict names the evidence it judged by its SHA-256")
+        return self
 
 

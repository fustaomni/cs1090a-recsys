+def retrust_if_rewritten(root: Path, before: str) -> None:
+    """A pull that rewrote mise.toml re-trusts it through the founding gate, or fails (A.126).
+
+    Under paranoid mode mise binds trust to a config's content, so a pull that rewrites
+    mise.toml leaves this checkout untrusted, and every task here refused. worktree:refresh
+    re-trusts since A.122; sync does the same, through the same _trust, only on a change.
+    """
+    after = git("rev-parse", "HEAD", cwd=root).stdout.strip()
+    changed = git("diff", "--quiet", before, after, "--", "mise.toml", cwd=root).returncode != 0
+    if before != after and changed and not _trust(root).trusted:
+        raise SystemExit(
+            f"pulled into {root}, but its changed mise.toml was not trusted: "
+            "the founding policy refused it or mise could not trust it"
+        )
+
+
 def run(*args: str) -> None:
